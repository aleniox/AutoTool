# ---------------------------------------------------------------------------
# AutoTool - cau hinh. Copy file nay thanh `.env` roi chinh sua.
# ---------------------------------------------------------------------------

# Web server
HOST=127.0.0.1
PORT=8787

# Thu muc du lieu (DB, media, browser profile, screenshot). Mac dinh: ./data
# AUTOTOOL_DATA_DIR=F:\AutoTool\data

# --- Browser -----------------------------------------------------------------
# Browser engine dung cho Playwright. Tren Windows nen dung `msedge` hoac `chrome`
# de khong phai tai Chromium (~130MB).
#   msedge | chrome | chromium
BROWSER_CHANNEL=msedge

# true = chay an (khong hien cua so). Nen de false khi dang test selector.
HEADLESS=false

# Ngon ngu / mui gio cua browser (anh huong selector theo ngon ngu giao dien).
BROWSER_LOCALE=vi-VN
BROWSER_TIMEZONE=Asia/Ho_Chi_Minh
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900

# --- Worker / hang doi -------------------------------------------------------
# So item duoc xu ly song song. Moi account luon duoc xu ly tuan tu.
WORKER_CONCURRENCY=2

# Chu ky quet hang doi (ms)
WORKER_TICK_MS=3000

# Gioi han an toan toan cuc: so bai toi da moi account moi ngay.
# Dat 0 de tat gioi han (KHONG khuyen khich - de bi nền tang chan).
DEFAULT_DAILY_LIMIT=15

# Khoang nghi ngau nhien giua 2 bai cua cung 1 account (giay).
DEFAULT_MIN_DELAY_SEC=120
DEFAULT_MAX_DELAY_SEC=360

# So lan thu lai khi loi
DEFAULT_MAX_ATTEMPTS=3

# Cho phep chay che do dry-run (chi mo browser, dien noi dung, KHONG bam Dang)
ALLOW_DRY_RUN=true

# --- Bao mat -----------------------------------------------------------------
# Tool nay KHONG luu mat khau. Chi luu browser profile da dang nhap.
# Bat buoc dat true neu muon mo browser dang nhap qua API.
ALLOW_LOGIN_WINDOW=true

# --- Tro ly AI (Google Gemini) -----------------------------------------------
# Co the nhap truc tiep tren giao dien Web Dashboard hoac dat o day.
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash
